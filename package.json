{
  "name": "ai-sprite-image-generator",
  "version": "1.0.7",
  "description": "A TypeScript library and CLI tool to generate high-quality sprite images using GPT Image, Grok Imagine, Nano Banana and more via kie.ai",
  "keywords": [
    "ai",
    "assets",
    "creator",
    "game development",
    "gemini",
    "gen-ai",
    "generator",
    "gpt image",
    "grid",
    "grok imagine",
    "image",
    "kie ai",
    "logo",
    "nano banana pro",
    "photo",
    "qwen image",
    "seedream",
    "sprite",
    "sprite sheet",
    "thumbnail",
    "web development"
  ],
  "homepage": "https://github.com/tayles/ai-sprite-image-generator",
  "bugs": {
    "url": "https://github.com/tayles/ai-sprite-image-generator/issues"
  },
  "license": "MIT",
  "author": "tayles",
  "repository": {
    "type": "git",
    "url": "https://github.com/tayles/ai-sprite-image-generator.git"
  },
  "bin": {
    "ai-sprite-image-generator": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "release": "bumpp --commit --push --tag",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "bun run lint --fix",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "fix": "bun run fmt:fix && bun run lint:fix",
    "check": "bun run fmt && bun run lint",
    "check:ci": "bun run fmt && bun run lint --format=github",
    "preview-changelog": "bunx changelogithub --dry",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:ci": "bun test --coverage --coverage-reporter=lcov",
    "test:watch": "bun test --watch",
    "test:examples": "bun test --timeout 300000 ./test/integration-test.ts"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "bumpp": "^12.3.0",
    "bunup": "^0.16.32",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
